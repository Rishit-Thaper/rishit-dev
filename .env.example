# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Aiven PostgreSQL "Service URI" from the Aiven console (service overview page).
# Must include sslmode=require.
DATABASE_URL=postgres://user:password@host:port/defaultdb?sslmode=require

# Google AI Studio API key (https://aistudio.google.com/apikey) — free tier, no card required.
GEMINI_API_KEY=

# Google Cloud OAuth client (Desktop app type) — see scripts/google-oauth-setup.mjs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Where booked calls go / who organizes them.
RISHIT_EMAIL=thaperrishit@gmail.com

# Stable resume URL, returned by the get_resume tool. public/resume.pdf is
# auto-rebuilt from resume/resume.tex by .github/workflows/build-resume.yml —
# this path never changes even as the resume content does.
RESUME_URL=/resume.pdf
